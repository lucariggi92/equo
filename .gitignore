# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Env (mantieni .env.example)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.local

# Raccolta dati e processi operativi (solo locale, non versionati)
_v2/

# File di lock di Office
~$*

# Script SQL con credenziali locali
*.local.sql

# Credenziali client MySQL locali
*.local.cnf

# Backup locali del database (solo la cartella va su git)
database-mysql/backup/*
!database-mysql/backup/.gitkeep
